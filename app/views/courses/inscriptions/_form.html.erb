<%= form_with(url: courses_inscriptions_path, builder: BootstrapBuilder, data: {controller: "inscriptions--form"}) do |form| %>
  <div class="form-group row mb-2">
    <%= form.label :cuil, "Cuil" %>
    <%= form.text_field :cuil,
        class: "form-control-sm",
        data: {
          inscriptions__form_target: "query",
          action: "change->inscriptions--form#search_person",
        } %>
  </div>
  <div class="form-group row mb-2">
    <%= form.label :person, "Persona" %>
    <%= form.text_field :person,
        class: "form-control-sm",
        disabled: true,
        data: {
          inscriptions__form_target: "personName",
          action: "change->inscriptions--form#search_person",
        } %>
    <%= form.hidden_field :person_id, data: {inscriptions__form_target: "personId"} %>
  </div>

  <div class="form-group row mb-3">
    <%= form.label :course_type, "Tipo de curso" %>
    <div class="col-12 col-sm-6">
      <select name="course[type]" id="course_type" 
        data-inscriptions--form-target="selectCourseCategory" 
        data-action="change->inscriptions--form#get_courses"
        class="form-control form-control-sm">
        <option value="">Seleccione tipo de curso</option>
        <option value="light" data-category="inicio">Inicio liviano</option>
        <option value="heavy" data-category="inicio">Inicio pesado</option>
        <option value="light" data-category="renovacion">Renovación liviano</option>
        <option value="heavy" data-category="renovacion">Renovación pesado</option>
      </select>
    </div>
  </div>

  <%= turbo_frame_tag :select_courses do %>
  <% end %>

  <div>
    <%= form.submit "Guardar" %>
    <button type="button" class="btn btn-sm btn-danger" data-bs-dismiss="modal">Cancelar</button>
  </div>
<% end %>
