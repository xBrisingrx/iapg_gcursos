<%= turbo_frame_tag "select_courses" do %>
  <%= tag.div class: "form-group row mb-3" do %>
    <select name="" data-controller="tselect" data-action="change->inscriptions--form#select_course">
      <option value="">Seleccione curso</option>
      <% courses.each do |course| %>
        <option value="<%= course.id %>"><%= course.course_type.name %></option>
      <% end %>
    </select>
  <% end %>
<% end %>