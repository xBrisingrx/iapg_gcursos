<%= turbo_frame_tag "select_courses" do %>
  <%= tag.div class: "form-group row mb-3" do %>
    <div class="col-12 col-sm-3">
      <label for="">Curso</label>
    </div>
    <div class="col-12 col-sm-6">
      <select name="" 
        data-controller="tselect" 
        data-action="change->inscriptions--form#select_course" 
        class="form-control form-control-sm">
        <option value="">Seleccione curso</option>
        <% courses.each do |course| %>
          <option value="<%= course.id %>"><%= "#{course.course_type.name} #{course.room.name} #{date_format(course.from_date)}" %></option>
        <% end %>
      </select>
    </div>
  <% end %>
<% end %>